# ingestion-apple-itunes image. Build context is the cubelake monorepo
# root (two levels up), matching this Dockerfile's COPY paths. Run
# from this directory, or `just -f infra/ingestion-apple-itunes/justfile <recipe>`.

default:
    @just --list

# Build the image
build:
    docker build -f dockerfile -t cubelake/ingestion-apple-itunes ../..

# Run the image once, e.g. `just run python -c "import ingestion_apple_itunes"`
run *args: build
    docker run --rm --env-file ../../.env cubelake/ingestion-apple-itunes {{ args }}
