# Airflow stack (Docker Compose). Run from this directory, or
# `just -f infra/appstore-dags/justfile <recipe>` from anywhere.

default:
    @just --list

# One-time: run DB migrations and create the default admin user
init:
    docker compose up airflow-init

# Start the full stack (api-server, scheduler, dag-processor, triggerer, postgres) in the background
up:
    docker compose up -d

# Stop the stack (keeps the postgres volume)
down:
    docker compose down

# Stop the stack and remove volumes — fresh Airflow metadata DB on next `init`
nuke:
    docker compose down -v

# Follow logs for all services
logs:
    docker compose logs -f

# Show container status
ps:
    docker compose ps

# Restart everything
restart: down up

# Run an `airflow` CLI command via the debug profile, e.g. `just cli dags list`
cli *args:
    docker compose --profile debug run --rm airflow-cli airflow {{ args }}
