# Build context: cubelake workspace root
# docker build -f infra/appstore-dags/dockerfile .
# https://hub.docker.com/r/apache/airflow
FROM apache/airflow:3.2.0-python3.13

USER root

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh

ENV PATH="/root/.local/bin/:$PATH"

WORKDIR /app

# Copy workspace metadata first — layer cache for dependency changes
COPY pyproject.toml uv.lock ./

# Copy only the workspace packages needed by appstore-dags
COPY appstore-transform/pyproject.toml ./appstore-transform/pyproject.toml
COPY appstore-core ./appstore-core
COPY ingestion-apple-rss ./ingestion-apple-rss
COPY ingestion-apple-itunes ./ingestion-apple-itunes
COPY appstore-dags ./appstore-dags

# Export external deps for appstore-dags (workspace packages filtered out)
# DAGs are loaded via mounted volume — appstore-dags itself is not installed as a package
RUN uv export --locked --no-dev --package appstore-dags -o /tmp/requirements.txt \
    && grep -v '^-e ' /tmp/requirements.txt | uv pip install --system -r /dev/stdin \
    && uv pip install --system --no-deps \
        ./appstore-core \
        ./ingestion-apple-rss \
        ./ingestion-apple-itunes \
    && rm -f /tmp/requirements.txt


ENV PYTHONPATH="/app:${PYTHONPATH}"
