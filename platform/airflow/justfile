# Airflow runtime. Run from this directory, or `just -f platform/airflow/justfile <recipe>`.

default:
    @just --list

# Create .env from .env.example with freshly generated secrets (refuses to overwrite)
secrets:
    #!/usr/bin/env bash
    set -euo pipefail
    [ -f .env ] && { echo ".env already exists — not overwriting"; exit 1; }
    rand() { openssl rand -base64 "$1" | tr -d '\n'; }
    fernet=$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n')
    sed -e "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$(rand 24 | tr -d '/+=')|" \
        -e "s|^AIRFLOW_FERNET_KEY=.*|AIRFLOW_FERNET_KEY=${fernet}|" \
        -e "s|^AIRFLOW_API_SECRET_KEY=.*|AIRFLOW_API_SECRET_KEY=$(rand 32)|" \
        -e "s|^AIRFLOW_JWT_SECRET=.*|AIRFLOW_JWT_SECRET=$(rand 32)|" \
        -e "s|^AIRFLOW_ADMIN_PASSWORD=.*|AIRFLOW_ADMIN_PASSWORD=$(rand 18 | tr -d '/+=')|" \
        .env.example > .env
    chmod 600 .env
    echo "Wrote .env (admin password is in AIRFLOW_ADMIN_PASSWORD)"

# Build the three service images
images:
    docker compose --profile images build

# First-time setup: secrets, images, local lake permissions, DB migration + admin user
init:
    [ -f .env ] || just secrets
    just images
    docker compose --profile local-lake run --rm lake-init
    docker compose up airflow-init

# Start Airflow (UI on http://localhost:8080)
up:
    docker compose up -d

# Stop (keeps data)
down:
    docker compose down

# Stop and delete Airflow DB + logs (the lake volume is kept)
nuke:
    docker compose down -v

logs:
    docker compose logs -f

ps:
    docker compose ps

# Run an airflow CLI command, e.g. `just cli dags list`
cli *args:
    docker compose exec airflow-scheduler airflow {{ args }}
