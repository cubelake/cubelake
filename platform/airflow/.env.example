# Copy to .env (`just secrets` does this and fills in the generated secrets).
# Never commit .env.

# --- Airflow / Postgres (generated by `just secrets`) ---
POSTGRES_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_API_SECRET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=

# --- apple-rss ---
APPLE_RSS_IMAGE=apple-rss:local
APPLE_RSS_LAKE_VOLUME=cubelake-lake           # local dev only; remove on GCS
APPLE_RSS_BRONZE_URI=/lake/bronze/appstore_rss
APPLE_RSS_SILVER_URI=/lake/silver/appstore_rss

# --- apple-itunes ---
APPLE_ITUNES_IMAGE=apple-itunes:local
APPLE_ITUNES_LAKE_VOLUME=cubelake-lake
APPLE_ITUNES_RSS_SILVER_URI=/lake/silver/appstore_rss
APPLE_ITUNES_BRONZE_URI=/lake/bronze/appstore_itunes
APPLE_ITUNES_SILVER_URI=/lake/silver/appstore_itunes

# --- appstore-analytics ---
APPSTORE_ANALYTICS_IMAGE=appstore-analytics:local
APPSTORE_ANALYTICS_LAKE_VOLUME=cubelake-lake
APPSTORE_ANALYTICS_RSS_SILVER_URI=/lake/silver/appstore_rss
APPSTORE_ANALYTICS_ITUNES_SILVER_URI=/lake/silver/appstore_itunes
APPSTORE_ANALYTICS_SILVER_URI=/lake/silver/appstore
APPSTORE_ANALYTICS_GOLD_URI=/lake/gold

# On GCP each service gets gs:// URIs instead, e.g.
#   APPLE_RSS_BRONZE_URI=gs://cubelake-bronze/appstore_rss
# plus its own HMAC key for dbt/DuckDB: <PREFIX>GCS_HMAC_KEY_ID / <PREFIX>GCS_HMAC_SECRET
